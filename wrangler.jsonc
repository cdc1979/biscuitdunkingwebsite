{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biscuit-dunking",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEADERBOARD", "class_name": "Leaderboard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Leaderboard"] }
  ]
}
